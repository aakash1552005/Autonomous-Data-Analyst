# ==============================================================================
# Autonomous Data Analyst — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# The application works out of the box with Ollama (no API key needed).
# ==============================================================================

# --- Ollama (Default LLM Provider — free, local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenAI (Optional — only if you want to use a hosted LLM instead) ---
# Leave blank to use Ollama as the default provider.
OPENAI_API_KEY=
