{
  "name": "Autonomous Data Analyst - Completion Poller",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 15
            }
          ]
        }
      },
      "id": "node-schedule-poll",
      "name": "Poll Interval Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5000/runs",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-get-runs",
      "name": "Fetch Recent Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-filter-completed",
      "name": "Filter Completed Runs",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-run-id",
              "name": "completed_run_id",
              "value": "={{ $json.run_id }}",
              "type": "string"
            },
            {
              "id": "assign-duration",
              "name": "duration_seconds",
              "value": "={{ $json.duration_seconds }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-completed",
      "name": "Format Completion Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 240]
    }
  ],
  "connections": {
    "Poll Interval Trigger": {
      "main": [
        [
          {
            "node": "Fetch Recent Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Runs": {
      "main": [
        [
          {
            "node": "Filter Completed Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Completed Runs": {
      "main": [
        [
          {
            "node": "Format Completion Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "id": "workflow-completion-02"
}
