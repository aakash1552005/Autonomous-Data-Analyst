{
  "name": "Autonomous Data Analyst - Scheduled Benchmark",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "node-cron-schedule",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/analyze",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file_path",
              "value": "data/sample/retail_sales.csv"
            },
            {
              "name": "preferred_target",
              "value": "revenue"
            },
            {
              "name": "async",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "node-run-benchmark",
      "name": "Execute Benchmark Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bench-summary",
              "name": "benchmark_result",
              "value": "=Daily benchmark finished with status {{ $json.status }}. Duration: {{ $json.duration_seconds }}s. Quality score: {{ $json.quality_score }}.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-log-benchmark",
      "name": "Log Benchmark Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Execute Benchmark Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Benchmark Run": {
      "main": [
        [
          {
            "node": "Log Benchmark Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "id": "workflow-benchmark-04"
}
