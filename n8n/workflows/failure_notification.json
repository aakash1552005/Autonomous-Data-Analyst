{
  "name": "Autonomous Data Analyst - Failure Alerting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "node-schedule-failure-poll",
      "name": "Periodic Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5000/runs",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-get-runs-failure",
      "name": "Fetch Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-failed-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "node-filter-failures",
      "name": "Is Failed Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert-text",
              "name": "alert_message",
              "value": "=CRITICAL: Pipeline run {{ $json.run_id }} failed with status {{ $json.status }}. Error count: {{ $json.error_count }}.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-format-failure-alert",
      "name": "Format Alert Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 240]
    }
  ],
  "connections": {
    "Periodic Check": {
      "main": [
        [
          {
            "node": "Fetch Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Runs": {
      "main": [
        [
          {
            "node": "Is Failed Run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Failed Run?": {
      "main": [
        [
          {
            "node": "Format Alert Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "id": "workflow-failure-03"
}
